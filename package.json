{
  "name": "ramp-shapes-perf",
  "version": "0.5.1",
  "description": "Performance benchmark for ramp-shapes",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --build --noemit",
    "bench-annotation": "tsx ./src/annotation.ts",
    "bench-iiif": "tsx ./src/iiif.ts",
    "generate-latex": "tsx ./src/latex.ts",
    "test-comparison": "tsx ./src/comparison.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexeyMz/ramp-shapes-perf.git"
  },
  "author": "Alexey Morozov <alexey.morozov@live.ru>",
  "license": "MIT",
  "dependencies": {
    "benchmark": "^2.1.4",
    "jsonld": "^5.2.0",
    "n3": "^2.7.12",
    "ramp-shapes": "^0.11.0",
    "sparqljs": "^3.7.4"
  },
  "devDependencies": {
    "@types/benchmark": "^2.1.5",
    "@types/n3": "^1.26.4",
    "@types/node": "^26.6.2",
    "@types/sparqljs": "^3.1.12",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@digitalbazaar/http-client": "file:./empty.js"
  }
}
